# Environment Configuration — Society Management System
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── Database (PostgreSQL via pgAdmin) ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_strong_database_password_here
DB_DATABASE=sms_development
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=true

# ─── TypeORM Migrations ──────────────────────────────────────────────────────
# Run: npx typeorm migration:run -d src/config/data-source.ts
TYPEORM_MIGRATIONS_RUN=false

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Min 32 chars — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_a_minimum_32_character_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_a_different_minimum_32_character_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS / Frontend URLs ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
GUARD_APP_URL=http://localhost:3002

# ─── File Storage (AWS S3 / Cloudflare R2) ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sms-documents-dev
AWS_S3_ENDPOINT=                    # Leave empty for AWS, set for R2/MinIO

# ─── Payment Gateway (Razorpay) ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── SMS Gateway (MSG91) ─────────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SMSALRT
MSG91_TEMPLATE_OTP=

# ─── Email (SendGrid) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=
FROM_EMAIL=noreply@societyms.com
FROM_NAME=Society Management System

# ─── WhatsApp (Meta Business API) ────────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10
