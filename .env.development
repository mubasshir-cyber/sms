# Application Environment — Development
# Copy from .env.example and fill in real values

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sms_development
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=true

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev_jwt_secret_minimum_32_chars_change_in_prod_00
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_minimum_32_chars_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
GUARD_APP_URL=http://localhost:3002

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ─── File Storage ─────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sms-documents-dev

# ─── Payment Gateway ──────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── SMS ──────────────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# ─── Email ────────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
FROM_EMAIL=noreply@societyms.com

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
